module std::mem

extern func malloc(usize size) -> *u8
extern func free(*u8 ptr) -> void

pub struct ArenaBlock {
    pub *ArenaBlock next
    pub *u8 buf
    pub usize offset
    pub usize capacity
}

pub struct Arena {
    pub *ArenaBlock head
    pub *ArenaBlock current
    pub usize block_capacity

    pub func init(*Arena self, usize initial_capacity) -> bool {
        return arena_init(self, initial_capacity)
    }

    pub func alloc(*Arena self, usize size, usize align) -> *u8 {
        return arena_alloc(self, size, align)
    }

    pub func reset(*Arena self) -> void {
        arena_reset(self)
    }

    pub func destroy(*Arena self) -> void {
        arena_destroy(self)
    }
}

pub func arena_block_new(usize cap) -> *ArenaBlock {
    if cap == 0 {
        return nil
    }

    *ArenaBlock block = malloc(sizeof(ArenaBlock)) as *ArenaBlock
    if block == nil {
        return nil
    }

    *u8 mem = malloc(cap)
    if mem == nil {
        free(block as *u8)
        return nil
    }

    block.next = nil
    block.buf = mem
    block.offset = 0
    block.capacity = cap
    return block
}

func arena_init(*Arena arena, usize initial_capacity) -> bool {
    *ArenaBlock first = arena_block_new(initial_capacity)
    if first == nil {
        (*arena).head = nil
        (*arena).current = nil
        (*arena).block_capacity = 0
        return false
    }

    (*arena).head = first
    (*arena).current = first
    (*arena).block_capacity = initial_capacity
    return true
}

func arena_reset(*Arena arena) -> void {
    *ArenaBlock cur = (*arena).head
    while cur != nil {
        cur.offset = 0
        cur = cur.next
    }
    (*arena).current = (*arena).head
}

func arena_destroy(*Arena arena) -> void {
    *ArenaBlock cur = (*arena).head
    while cur != nil {
        *ArenaBlock next = cur.next
        if cur.buf != nil {
            free(cur.buf)
        }
        free(cur as *u8)
        cur = next
    }

    (*arena).head = nil
    (*arena).current = nil
    (*arena).block_capacity = 0
}

func arena_alloc(*Arena arena, usize size, usize align) -> *u8 {
    if align == 0 || (align & (align - 1)) != 0 {
        return nil
    }

    *ArenaBlock block = (*arena).current
    if block == nil {
        return nil
    }

    usize mask = ~(align - 1)
    usize aligned = (block.offset + align - 1) & mask

    if aligned > block.capacity || size > block.capacity - aligned {
        usize needed = aligned + size
        usize next_cap = (*arena).block_capacity
        if needed > next_cap {
            next_cap = needed
        }

        *ArenaBlock grown = arena_block_new(next_cap)
        if grown == nil {
            return nil
        }

        block.next = grown
        (*arena).current = grown
        block = grown
        aligned = 0
    }

    block.offset = aligned + size
    return block.buf + aligned
}
