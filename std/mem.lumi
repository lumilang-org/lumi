module std::mem

extern func malloc(usize size) -> *u8
extern func free(*u8 ptr) -> void

struct Arena {
    *u8 buf
    usize offset
    usize capacity
}

func arena_init(*Arena arena, usize capacity) -> bool {
    if capacity == 0 {
        (*arena).buf = nil
        (*arena).offset = 0
        (*arena).capacity = 0
        return false
    }

    *u8 mem = malloc(capacity)

    if mem == nil {
        (*arena).buf = nil
        (*arena).offset = 0
        (*arena).capacity = 0
        return false
    }

    (*arena).buf = mem
    (*arena).offset = 0
    (*arena).capacity = capacity
    return true
    
}

func arena_reset(*Arena arena) -> void {
    (*arena).offset = 0
}

func arena_destroy(*Arena arena) -> void {
    if (*arena).buf != nil {
        free((*arena).buf)
    }

    (*arena).buf = nil
    (*arena).offset = 0
    (*arena).capacity = 0
}

func arena_alloc(*Arena arena, usize size, usize align) -> *u8 {
    if align == 0 || (align & (align - 1)) != 0 {
        return nil
    }

    usize mask = ~(align - 1)
    usize aligned = ((*arena).offset + align - 1) & mask

    if aligned > (*arena).capacity {
        return nil
    }

    usize remaining = (*arena).capacity - aligned
    if size > remaining {
        return nil
    }

    (*arena).offset = aligned + size
    return (*arena).buf + aligned
}